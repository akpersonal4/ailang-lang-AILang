// Root main example - demonstrates file I/O and list operations
import file;
import list;
import json;

fn main() {
    let dataDir = "data";

    if (file.exists(dataDir) == false) {
        file.write(dataDir + "/.gitkeep", "");
    }

    let items = list.new();
    list.append(items, "Widget");
    list.append(items, "Gadget");
    list.append(items, "Doohickey");

    print("Created " + list.len(items) + " items");

    let jsonData = json.stringify(items);
    file.write(dataDir + "/items.json", jsonData);

    let loaded = json.parse(file.read(dataDir + "/items.json"));
    print("Loaded " + list.len(loaded) + " items");

    return 0
}
