// Member function calls example - demonstrates calling functions from maps
import map;

fn max_func(x, y) {
    if (x > y) {
        return x
    } else {
        return y
    }
}

fn main() {
    let math = map.new();
    map.set(math, "max", max_func);

    let maxFn = map.get(math, "max");
    print(maxFn(10, 20));

    return 0
}
